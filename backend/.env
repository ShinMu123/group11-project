# ===========================
# Cấu hình Server
# ===========================
PORT=3000
JWT_SECRET=supersecretkey

# ===========================
# MongoDB
# ===========================
MONGO_URI=mongodb+srv://admin:12345@groupdb.fppewgj.mongodb.net/groupdb?retryWrites=true&w=majority

# ===========================
# Email (SMTP) - dùng để gửi token reset password
# ===========================
EMAIL_HOST=smtp.gmail.com      # hoặc SMTP server bạn dùng
EMAIL_PORT=587                 # 587 cho TLS, 465 cho SSL
EMAIL_USER=youremail@gmail.com # email gửi
EMAIL_PASS=yourpassword        # mật khẩu hoặc app password

# ===========================
# Cloudinary - nếu dùng upload avatar
# ===========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
